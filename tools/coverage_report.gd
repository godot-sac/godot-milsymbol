extends SceneTree
## Writes docs/coverage.md: how many symbols of milsymbol's own test suite we draw exactly like milsymbol.
## <godot> --headless --path . -s res://tools/coverage_report.gd

const Coverage = preload("res://tests/helpers/coverage.gd")
const OUT_FILE := "res://docs/coverage.md"
const SET_NAMES := {
	"01": "Air", "02": "Air missile", "05": "Space", "06": "Space missile", "10": "Land unit",
	"11": "Land civilian unit/organization", "15": "Land equipment", "20": "Land installation",
	"25": "Control measure (points)", "27": "Dismounted individual", "30": "Sea surface", "35": "Sea subsurface",
	"36": "Mine warfare", "40": "Activities", "50": "Signals intelligence: space", "51": "Signals intelligence: air",
	"52": "Signals intelligence: land", "53": "Signals intelligence: surface",
	"54": "Signals intelligence: subsurface", "60": "Cyberspace",
}


func _init() -> void:
	var entries := Coverage.load_entries()
	if entries.is_empty():
		push_error("no coverage data; run `npm run coverage` in tools/export")
		quit(1)
		return
	var summary := Coverage.summarize(entries, SET_NAMES)
	var md := "# Symbol coverage\n\n"
	md += "Generated by `tools/coverage_report.gd` from `tests/golden/coverage.json` "
	md += "(`tools/export/coverage.mjs`). Do not edit by hand.\n\n"
	md += "The symbol lists are the ones milsymbol's own test suite walks (`test/number-sidc.js`): every point main\n"
	md += "icon, modifier 1 and modifier 2 of each symbol set in the standards data packages `mil-std-2525` (2525D),\n"
	md += "`milstandard-e` (2525E) and `stanag-app6` (APP-6D). Each SIDC is rendered by milsymbol 3.0.5 and by\n"
	md += "godot-milsymbol; *matches* counts symbols whose SVG, size, anchor and validity are the same.\n"
	md += "*Valid in milsymbol* counts the symbols milsymbol itself can draw; the rest are drawn as an unknown icon\n"
	md += "by both libraries. Lines and areas (multipoint control measures) are not part of these lists; see\n"
	md += "`docs/control-measures.md`.\n\n"
	var grand := {"total": 0, "valid": 0, "match": 0}
	for standard in Coverage.STANDARDS:
		var by_set: Dictionary = summary[standard]
		var totals := {"total": 0, "valid": 0, "match": 0}
		md += "## %s\n\n| Symbol set | Symbols | Valid in milsymbol | Matches milsymbol |\n|---|---:|---:|---:|\n" % standard
		var sets := by_set.keys()
		sets.sort()
		for symbol_set in sets:
			var row: Dictionary = by_set[symbol_set]
			md += "| %s %s | %d | %d | %d |\n" % [symbol_set, SET_NAMES.get(symbol_set, ""), row.total, row.valid, row.match]
			for key in totals:
				totals[key] += row[key]
		md += "| **Total** | **%d** | **%d** | **%d** |\n\n" % [totals.total, totals.valid, totals.match]
		for key in grand:
			grand[key] += totals[key]
	md += "All standards: %d symbols, %d valid in milsymbol, %d match.\n" % [grand.total, grand.valid, grand.match]
	var failures: Array = summary.failures
	if not failures.is_empty():
		md += "\n## Differences\n\n```\n%s\n```\n" % "\n".join(failures.slice(0, 50))
	var file := FileAccess.open(OUT_FILE, FileAccess.WRITE)
	file.store_string(md)
	file.close()
	print("wrote %s: %d symbols, %d match" % [OUT_FILE, grand.total, grand.match])
	quit(0 if failures.is_empty() else 1)
